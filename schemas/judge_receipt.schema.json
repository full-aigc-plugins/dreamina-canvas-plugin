{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dreamina-canvas/schemas/judge_receipt.schema.json",
  "title": "JudgeReceipt",
  "description": "Structured verdict from an independent Judge. Binds both images by content digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "judgeId",
    "adapter",
    "modelClass",
    "targetSha256",
    "candidateSha256",
    "scores",
    "gaps",
    "recommendation",
    "freshContext",
    "sawPromptDraft",
    "judgedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "judge_receipt/1"
    },
    "judgeId": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "adapter": {
      "enum": [
        "host_subagent",
        "dreamina_design_skill",
        "external_mcp",
        "human"
      ]
    },
    "modelClass": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "targetSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidateSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition",
        "lighting",
        "materials",
        "details",
        "total"
      ],
      "properties": {
        "composition": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "lighting": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "materials": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "details": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "total": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "severity",
          "location",
          "observation",
          "fixHint"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "composition",
              "lighting",
              "materials",
              "details"
            ]
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "fixHint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "recommendation": {
      "enum": [
        "accept",
        "revise",
        "replan",
        "reject"
      ]
    },
    "freshContext": {
      "const": true
    },
    "sawPromptDraft": {
      "const": false
    },
    "judgedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}

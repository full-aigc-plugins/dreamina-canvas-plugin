{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-dreamina-canvas/schemas/approval_receipt.schema.json",
  "title": "ApprovalReceipt",
  "description": "Output of dreamina-canvas node confirm. The short-lived approval credential is bound to the request and is NEVER persisted or journaled.",
  "type": "object",
  "additionalProperties": false,
  "required": ["quoteId", "projectId", "orderedNodeIds", "ceiling", "currency", "unit", "expiry", "requestFingerprint"],
  "properties": {
    "quoteId": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "orderedNodeIds": {
      "type": "array",
      "items": {"type": "string"}
    },
    "ceiling": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {"type": "string"},
    "unit": {"type": "string"},
    "expiry": {"type": "string", "format": "date-time"},
    "requestFingerprint": {
      "type": "string",
      "description": "Canonical sorted-key JSON SHA-256 of the request; non-secret."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dreamina-canvas/schemas/visual_loop_state.schema.json",
  "title": "VisualLoopState",
  "description": "The only source of execution permission. Never widens budget or retargets on stall.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "state",
    "currentRound",
    "pendingOperations",
    "receiptRefs",
    "stopRequested",
    "revisionCount",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "visual_loop_state/1"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$",
      "description": "Session binding: the store refuses a state file from another session."
    },
    "state": {
      "enum": [
        "CREATED",
        "TARGET_LOCKED",
        "TARGET_REGISTERED",
        "DRAFT_SAVED",
        "QUOTED",
        "AWAITING_APPROVAL",
        "SUBMITTED",
        "WAITING",
        "ARTIFACT_VERIFIED",
        "AWAITING_JUDGE",
        "JUDGED",
        "REVISION_PROPOSED",
        "COMPLETED",
        "PAUSED",
        "STALLED",
        "STOP_REQUESTED",
        "DRAINING_ACCEPTED",
        "STOPPED",
        "FAILED"
      ]
    },
    "currentRound": {
      "type": "integer",
      "minimum": 0
    },
    "bestRound": {
      "type": "integer",
      "minimum": 0
    },
    "targetId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f-]{36}$",
      "description": "Absent until a target is locked."
    },
    "pendingOperations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId"
        ],
        "properties": {
          "submitId": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "nodeId": {
            "type": "string",
            "pattern": "^node_[A-Za-z0-9_-]+$"
          }
        }
      }
    },
    "receiptRefs": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "target",
              "round",
              "judge_request",
              "judge_receipt",
              "prompt_revision",
              "budget",
              "quote",
              "approval"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "stopRequested": {
      "type": "boolean"
    },
    "remoteCancelled": {
      "const": false,
      "description": "Honest stop semantics: stopping prevents NEW submissions only."
    },
    "revisionCount": {
      "type": "integer",
      "minimum": 0
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "safety": {
      "description": "Durable budget and request binding. An absent/empty legacy snapshot cannot authorize mid-round execution.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ledger",
            "reservation",
            "quote",
            "policy",
            "attempted"
          ],
          "properties": {
            "ledger": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "spent",
                "reserved",
                "unknown"
              ],
              "properties": {
                "spent": {
                  "type": "integer",
                  "minimum": 0
                },
                "reserved": {
                  "type": "integer",
                  "minimum": 0
                },
                "unknown": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "reservation": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "quote_id",
                    "credits",
                    "settled"
                  ],
                  "properties": {
                    "quote_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "credits": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "settled": {
                      "const": false
                    }
                  }
                }
              ]
            },
            "quote": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "quote_id",
                    "total_max_credits",
                    "confirmable",
                    "request_fingerprint",
                    "project_id"
                  ],
                  "properties": {
                    "quote_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "total_max_credits": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "confirmable": {
                      "const": true
                    },
                    "request_fingerprint": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "project_id": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "policy": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "const": "per_round"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "max_rounds",
                    "max_total_credits",
                    "max_per_round",
                    "deadline_epoch",
                    "rounds_started"
                  ],
                  "properties": {
                    "mode": {
                      "const": "bounded_batch"
                    },
                    "max_rounds": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "max_total_credits": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "max_per_round": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "deadline_epoch": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "rounds_started": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "attempted": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "SUBMITTED",
              "WAITING",
              "DRAINING_ACCEPTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingOperations": {
            "minItems": 1,
            "items": {
              "required": [
                "submitId",
                "nodeId"
              ]
            }
          }
        }
      }
    }
  ]
}
